{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "contact": {
    "homepage": "https://minuit.dryaides.com/",
    "sources": "${sources_url}",
    "issues": "${issues_url}"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.dryaides.minuit.fabric.MinuitFabric"],
    "client": ["dev.dryaides.minuit.fabric.MinuitFabricClient"]
  },
  "mixins": ["minuit.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16",
    "${fabric_api_id}": "*",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}"
  },
  "custom": {
    "modmenu": {
      "badges": ["library"]
    }
  }
}
